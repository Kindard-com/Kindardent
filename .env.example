# Public site URL (production)
NEXT_PUBLIC_SITE_URL=https://kindardent.com

# Turso / libSQL (profile API)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Reown AppKit (WalletConnect) — allowlist kindardent.com in Reown Cloud
NEXT_PUBLIC_REOWN_PROJECT_ID=your-reown-project-id

# Payload CMS (admin at /admin)
PAYLOAD_SECRET=change-me-to-a-long-random-string
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# Seed / admin bootstrap (local dev only — /api/seed disabled in production)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
